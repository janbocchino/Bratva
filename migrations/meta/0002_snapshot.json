      "definition": "\n\tSELECT\n\t\tuser_id,\n\t\tasset_id,\n\t\tCAST(SUM(CASE WHEN dr_cr = 'cr' THEN amount ELSE -amount END) AS TEXT) AS balance\n\tFROM ledger_entries\n\tGROUP BY user_id, asset_id\n"
