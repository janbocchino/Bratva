          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "amount": {
          "name": "amount",
          "type": "blob",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "unit": {
          "name": "unit",
          "type": "text",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "created_at": {
          "name": "created_at",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "balance": {
          "name": "balance",
          "type": "blob",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        }
      },
      "name": "ledger_entries_with_balance",
      "isExisting": false,
      "definition": "\n\tSELECT\n\t\tledger_entries.id,\n\t\tledger_entries.user_id,\n\t\tledger_entries.asset_id,\n\t\tledger_entries.dr_cr,\n\t\tledger_entries.amount,\n\t\tledger_entries.unit,\n\t\tledger_entries.created_at,\n\t\tledger_summary_entries.balance\n\tFROM ledger_entries\n\tINNER JOIN ledger_summary_entries\n\t\tON ledger_entries.user_id = ledger_summary_entries.user_id\n\t\tAND ledger_entries.asset_id = ledger_summary_entries.asset_id\n"
    },
    "ledger_summary_entries": {
      "columns": {
        "user_id": {
          "name": "user_id",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "asset_id": {
          "name": "asset_id",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "balance": {
          "name": "balance",
          "type": "blob",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        }
      },
      "name": "ledger_summary_entries",
      "isExisting": false,
      "definition": "\n\tSELECT\n\t\tuser_id,\n\t\tasset_id,\n\t\tCAST(SUM(CASE WHEN dr_cr = 'cr' THEN amount ELSE -amount END) AS TEXT) AS balance\n\tFROM ledger_entries\n\tGROUP BY user_id, asset_id\n"
    }
